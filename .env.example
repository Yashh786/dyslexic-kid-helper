# Copy this file to ".env" (same folder as docker-compose.yml) and fill in
# real values before deploying. docker-compose reads ".env" automatically.
# Never commit your actual ".env" file - it's already in .gitignore.

# Long, random secret used to sign JWT auth tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# If left blank, the backend will auto-generate a temporary one on each
# restart (fine for a quick local try, NOT fine for a real deployment -
# sessions will invalidate every time the server restarts).
JWT_SECRET_KEY=

# Set APP_ENV=production only when deploying publicly. Production requires
# JWT_SECRET_KEY, GROQ_API_KEY, and a specific HTTPS ALLOWED_ORIGINS value.
APP_ENV=development

# Groq cloud AI credentials. Never commit the real key.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# SQLAlchemy database URL. Default is a local SQLite file (fine for a demo,
# not durable in most cloud/container hosting - data is lost on redeploy
# unless the volume persists). For production, point this at a managed
# Postgres/MySQL instance instead, e.g.:
#   postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:///profiles.db

# Set to "true" only for local development. Must stay "false" in any
# deployment reachable by others - Flask's debug mode can allow remote code
# execution if exposed.
FLASK_DEBUG=false

# Public URL of the backend API, used by the frontend at BUILD time (baked
# into the compiled React app - changing this requires rebuilding the
# frontend image). Point this at your deployed backend's real URL.
REACT_APP_API_URL=http://localhost:5000

# Comma-separated list of frontend origins allowed to call this API, e.g.:
#   ALLOWED_ORIGINS=https://myapp.com,https://www.myapp.com
# Defaults to "*" (any origin) which is fine for local dev, but should be
# restricted to your real frontend URL(s) in production.
ALLOWED_ORIGINS=*
