# ═══════════════════════════════════════════════════════════════════════════════
# LexiRead — Environment Variables
# ═══════════════════════════════════════════════════════════════════════════════
# Copy this file to ".env" (same folder as docker-compose.yml) and fill in
# real values before deploying. docker-compose reads ".env" automatically.
#
# ⚠️  NEVER commit your real ".env" to Git — it is already in .gitignore.
# ═══════════════════════════════════════════════════════════════════════════════


# ── Environment mode ──────────────────────────────────────────────────────────
# Set to "production" when deploying publicly.
# In production mode the backend HARD FAILS on startup if JWT_SECRET_KEY,
# GROQ_API_KEY, or ALLOWED_ORIGINS are missing/insecure.
APP_ENV=development


# ── JWT Secret Key ────────────────────────────────────────────────────────────
# Long, random secret used to sign auth tokens.
# Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# If left blank in dev, the backend auto-generates a temporary one each restart
# (sessions will invalidate on every restart — not for production).
JWT_SECRET_KEY=


# ── Groq AI ───────────────────────────────────────────────────────────────────
# Required for word definitions, text simplification, and quiz generation.
# Get a FREE key at: https://console.groq.com/keys
# The backend hard-fails in production if this is not set.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b


# ── Database ──────────────────────────────────────────────────────────────────
# Default: SQLite file inside the container (fine for local dev, but data is
# LOST every time the container is recreated — not suitable for production).
#
# For production, use a managed Postgres database. Free options:
#   • Render Postgres:   https://render.com (free tier)
#   • Supabase:          https://supabase.com (free tier)
#   • Railway:           https://railway.app (free tier)
#   • Neon:              https://neon.tech (free tier)
#
# Example:
#   DATABASE_URL=postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:///profiles.db


# ── Frontend API URL ──────────────────────────────────────────────────────────
# The PUBLIC URL where your backend is reachable from the browser.
# This is baked into the React build at BUILD TIME — changing it requires
# rebuilding the frontend image.
#
# Local dev:     http://localhost:5000
# Production:    https://your-backend-name.onrender.com  (or your domain)
REACT_APP_API_URL=http://localhost:5000


# ── CORS Allowed Origins ──────────────────────────────────────────────────────
# Comma-separated list of frontend origins allowed to call this API.
# Local dev:     * (any origin)
# Production:    https://your-frontend-name.onrender.com
#
# The backend HARD FAILS in production if this is still "*".
ALLOWED_ORIGINS=*


# ── Flask Debug Mode ──────────────────────────────────────────────────────────
# Set "true" ONLY for local development.
# NEVER enable in production — Flask's debugger allows remote code execution.
FLASK_DEBUG=false


# ── Sentry Error Monitoring (optional but recommended) ────────────────────────
# Catch and track crashes in real time. Free tier: 5,000 errors/month.
# Sign up at: https://sentry.io → Create Project → Get DSN
# Leave blank to disable Sentry entirely.
SENTRY_DSN=

# Frontend Sentry DSN (can be the same project or a separate one)
# Baked into the React build at BUILD TIME — requires rebuild to change.
REACT_APP_SENTRY_DSN=
