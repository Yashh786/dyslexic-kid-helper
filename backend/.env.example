# Copy this file to ".env" in this backend/ folder if you're running the
# backend manually with "python app.py" (not via docker-compose - that path
# uses the .env.example in the project root instead).

# Long, random secret used to sign JWT auth tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# Set APP_ENV=production only when deploying publicly.
APP_ENV=development

# Groq cloud AI credentials. Never commit the real key.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# SQLAlchemy database URL. Default is fine for local dev.
DATABASE_URL=sqlite:///profiles.db

# Set to "true" only for local development.
FLASK_DEBUG=false

# Comma-separated list of allowed frontend origins, or "*" for any (dev only).
ALLOWED_ORIGINS=*
